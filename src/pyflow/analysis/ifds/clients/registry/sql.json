{
  "framework": "sql",
  "version": "1.0",
  "description": "Raw SQL sinks — sqlite3, psycopg2, MySQLdb, pymysql",
  "detection": {
    "imports": ["sqlite3", "psycopg2", "MySQLdb", "pymysql", "import sqlite3", "import psycopg2", "import MySQLdb", "import pymysql"],
    "patterns": ["cursor.execute(", "conn.execute(", ".execute(", ".executemany(", ".executescript("]
  },
  "models": [
    {"call": "sqlite3.Cursor.execute", "taint_sink": true},
    {"call": "sqlite3.Cursor.executemany", "taint_sink": true},
    {"call": "sqlite3.Cursor.executescript", "taint_sink": true},
    {"call": "sqlite3.Connection.execute", "taint_sink": true},
    {"call": "sqlite3.connect", "taint_sink": true, "typestate_open": true, "resource_arg_positions": []},
    {"call": "psycopg2.cursor.execute", "taint_sink": true},
    {"call": "psycopg2.cursor.executemany", "taint_sink": true},
    {"call": "psycopg2.connect", "taint_sink": true, "typestate_open": true, "resource_arg_positions": []},
    {"call": "MySQLdb.cursor.execute", "taint_sink": true},
    {"call": "MySQLdb.connect", "taint_sink": true, "typestate_open": true, "resource_arg_positions": []},
    {"call": "pymysql.cursor.execute", "taint_sink": true},
    {"call": "pymysql.connect", "taint_sink": true, "typestate_open": true, "resource_arg_positions": []},
    {"call": "close", "typestate_close": true},
    {"call": "cursor", "typestate_use": true},
    {"call": "execute", "typestate_use": true},
    {"call": "executemany", "typestate_use": true},
    {"call": "executescript", "typestate_use": true},
    {"call": "fetchone", "typestate_use": true, "nullness_nullable_return": true},
    {"call": "fetchmany", "typestate_use": true, "nullness_nullable_return": true},
    {"call": "fetchall", "typestate_use": true},
    {"call": "sqlite3.Connection.cursor", "typestate_open": true, "resource_arg_positions": []},
    {"call": "psycopg2.connection.cursor", "typestate_open": true, "resource_arg_positions": []},
    {"call": "MySQLdb.connection.cursor", "typestate_open": true, "resource_arg_positions": []}
  ]
}
