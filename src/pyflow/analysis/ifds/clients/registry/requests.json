{
  "framework": "requests",
  "version": "1.0",
  "description": "Requests and httpx library taint sources and sinks",
  "detection": {
    "imports": ["requests", "import requests", "from requests", "httpx", "import httpx", "from httpx"],
    "patterns": ["requests.get(", "requests.post(", "requests.Session"]
  },
  "models": [
    {"call": "requests.get", "taint_source": true, "category": "network"},
    {"call": "requests.post", "taint_source": true, "category": "network"},
    {"call": "requests.put", "taint_source": true, "category": "network"},
    {"call": "requests.patch", "taint_source": true, "category": "network"},
    {"call": "requests.delete", "taint_source": true, "category": "network"},
    {"call": "requests.head", "taint_source": true, "category": "network"},
    {"call": "requests.request", "taint_source": true, "category": "network"},
    {"call": "urllib.request.urlopen", "taint_source": true, "taint_sink": true, "category": "network"},
    {"call": "urllib.request.urlretrieve", "taint_source": true, "taint_sink": true, "category": "network"},
    {"call": "httpx.get", "taint_source": true, "category": "network"},
    {"call": "httpx.post", "taint_source": true, "category": "network"},
    {"call": "httpx.request", "taint_source": true, "category": "network"},
    {"call": "aiohttp.ClientSession.get", "taint_source": true, "category": "network"},
    {"call": "aiohttp.ClientSession.post", "taint_source": true, "category": "network"},
    {"call": "aiohttp.ClientSession.request", "taint_source": true, "category": "network"},
    {"call": "requests.Session", "typestate_open": true, "track_method_receiver": false},
    {"call": "httpx.Client", "typestate_open": true, "track_method_receiver": false},
    {"call": "httpx.AsyncClient", "typestate_open": true, "track_method_receiver": false},
    {"call": "aiohttp.ClientSession", "typestate_open": true, "track_method_receiver": false},
    {"call": "close", "typestate_close": true},
    {"call": "get", "typestate_use": true},
    {"call": "post", "typestate_use": true},
    {"call": "put", "typestate_use": true},
    {"call": "delete", "typestate_use": true},
    {"call": "head", "typestate_use": true},
    {"call": "request", "typestate_use": true}
  ]
}
