{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pyflow.dev/schemas/ifds-rule-pack-v2.json",
  "title": "PyFlow IFDS Rule Pack v2",
  "type": "object",
  "required": ["schema_version", "framework", "version", "type", "models", "rules"],
  "properties": {
    "schema_version": {"const": 2},
    "framework": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "type": {"enum": ["taint", "typestate", "nullness"]},
    "description": {"type": "string"},
    "detection": {
      "type": "object",
      "properties": {
        "imports": {"type": "array", "items": {"type": "string"}},
        "patterns": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "models": {"type": "array"},
    "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}}
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "taint"}}},
      "then": {"properties": {"models": {"items": {"$ref": "#/$defs/taintModel"}}}}
    },
    {
      "if": {"properties": {"type": {"const": "typestate"}}},
      "then": {"properties": {"models": {"items": {"$ref": "#/$defs/typestateModel"}}}}
    },
    {
      "if": {"properties": {"type": {"const": "nullness"}}},
      "then": {"properties": {"models": {"items": {"$ref": "#/$defs/nullnessModel"}}}}
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "taintPort": {
      "oneOf": [
        {"const": "return"},
        {
          "type": "object",
          "required": ["parameter"],
          "properties": {"parameter": {"type": "integer", "minimum": 0}},
          "additionalProperties": false
        }
      ]
    },
    "taintEndpoint": {
      "type": "object",
      "required": ["kind", "port"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "port": {"$ref": "#/$defs/taintPort"}
      },
      "additionalProperties": false
    },
    "sanitizer": {
      "type": "object",
      "required": ["kinds", "port"],
      "properties": {
        "kinds": {
          "oneOf": [
            {"const": "all"},
            {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          ]
        },
        "port": {"$ref": "#/$defs/taintPort"}
      },
      "additionalProperties": false
    },
    "taintModel": {
      "type": "object",
      "required": ["call"],
      "anyOf": [
        {"required": ["sources"]},
        {"required": ["sinks"]},
        {"required": ["sanitizers"]}
      ],
      "properties": {
        "call": {"type": "string", "minLength": 1},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/taintEndpoint"}},
        "sinks": {"type": "array", "items": {"$ref": "#/$defs/taintEndpoint"}},
        "sanitizers": {"type": "array", "items": {"$ref": "#/$defs/sanitizer"}},
        "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
        "cwe": {"type": "string", "pattern": "^CWE-[0-9]+$"},
        "suggestion": {"type": "string"}
      },
      "additionalProperties": false
    },
    "typestateModel": {
      "type": "object",
      "required": ["call", "typestate_action", "typestate_protocol"],
      "properties": {
        "call": {"type": "string", "minLength": 1},
        "typestate_action": {"type": "string", "minLength": 1},
        "typestate_protocol": {"type": "string", "minLength": 1},
        "resource_arg_positions": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "track_method_receiver": {"type": "boolean"},
        "receiver_types": {"type": "array", "items": {"type": "string"}},
        "module_prefixes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "nullnessModel": {
      "type": "object",
      "required": ["call", "nullness_nullable_return"],
      "properties": {
        "call": {"type": "string", "minLength": 1},
        "nullness_nullable_return": {"const": true}
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": ["id", "title", "sources", "sinks", "severity"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "sinks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
        "cwe": {"type": "string", "pattern": "^CWE-[0-9]+$"},
        "suggestion": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
