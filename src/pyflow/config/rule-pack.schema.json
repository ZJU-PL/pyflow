{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pyflow.dev/schemas/taint-rule-pack-v2.json",
  "title": "PyFlow Rule Pack v2",
  "type": "object",
  "required": ["schema_version", "framework", "version", "type", "models", "rules"],
  "properties": {
    "schema_version": {"const": 2},
    "framework": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "type": {"enum": ["taint", "typestate", "nullness"]},
    "description": {"type": "string"},
    "entrypoints": {"$ref": "#/$defs/entrypoints"},
    "detection": {
      "type": "object",
      "properties": {
        "imports": {"type": "array", "items": {"type": "string"}},
        "patterns": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "models": {"type": "array"},
    "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}}
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "taint"}}},
      "then": {"properties": {"models": {"items": {"$ref": "#/$defs/taintModel"}}}}
    },
    {
      "if": {"properties": {"type": {"const": "typestate"}}},
      "then": {"properties": {"models": {"items": {"$ref": "#/$defs/typestateModel"}}}}
    },
    {
      "if": {"properties": {"type": {"const": "nullness"}}},
      "then": {"properties": {"models": {"items": {"$ref": "#/$defs/nullnessModel"}}}}
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "entrypoints": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "declared-only",
            "inferred-roots",
            "declared-plus-roots",
            "file-public",
            "all-procedures"
          ]
        },
        "include_synthetic_modules": {"type": "boolean"},
        "taint_parameters": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "taintPort": {
      "oneOf": [
        {"const": "return"},
        {"const": "all"},
        {"const": "receiver"},
        {
          "type": "object",
          "required": ["parameter"],
          "properties": {"parameter": {"type": "integer", "minimum": 0}},
          "additionalProperties": false
        }
      ]
    },
    "taintEndpoint": {
      "type": "object",
      "required": ["kind", "port"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "port": {"$ref": "#/$defs/taintPort"}
      },
      "additionalProperties": false
    },
    "sanitizer": {
      "type": "object",
      "required": ["kinds"],
      "anyOf": [
        {"required": ["port"]},
        {"required": ["to"]}
      ],
      "properties": {
        "kinds": {
          "oneOf": [
            {"const": "all"},
            {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          ]
        },
        "port": {"$ref": "#/$defs/taintPort"},
        "from": {"$ref": "#/$defs/taintPropagationPort"},
        "to": {"$ref": "#/$defs/taintPropagationPort"},
        "maps": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "preserves_unmentioned": {"type": "boolean"},
        "guard": {"type": "string", "minLength": 1},
        "mutates_input": {"type": "boolean"},
        "assumptions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "taintModel": {
      "type": "object",
      "required": ["call"],
      "anyOf": [
        {"required": ["sources"]},
        {"required": ["sinks"]},
        {"required": ["sanitizers"]},
        {"required": ["propagations"]}
      ],
      "properties": {
        "call": {"type": "string", "minLength": 1},
        "aliases": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "sources": {"type": "array", "items": {"$ref": "#/$defs/taintEndpoint"}},
        "sinks": {"type": "array", "items": {"$ref": "#/$defs/taintEndpoint"}},
        "sanitizers": {"type": "array", "items": {"$ref": "#/$defs/sanitizer"}},
        "propagations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/taintPropagation"}
        },
        "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
        "cwe": {"type": "string", "pattern": "^CWE-[0-9]+$"},
        "suggestion": {"type": "string"},
        "sink_behavior": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "taintPropagationPort": {
      "oneOf": [
        {"enum": ["all", "receiver", "return", "yield", "raise", "sink"]},
        {
          "type": "object",
          "required": ["parameter"],
          "properties": {
            "parameter": {"type": "integer", "minimum": 0},
            "path": {"$ref": "#/$defs/taintPath"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "path"],
          "properties": {
            "kind": {"enum": ["receiver", "return", "yield", "raise"]},
            "path": {"$ref": "#/$defs/taintPath"}
          },
          "additionalProperties": false
        }
      ]
    },
    "taintPath": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "taintPropagation": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": {"$ref": "#/$defs/taintPropagationPort"},
        "to": {"$ref": "#/$defs/taintPropagationPort"},
        "kinds": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "maps": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "removes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "guard": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "typestateModel": {
      "type": "object",
      "required": ["call", "typestate_action", "typestate_protocol"],
      "properties": {
        "call": {"type": "string", "minLength": 1},
        "aliases": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "typestate_action": {"type": "string", "minLength": 1},
        "typestate_protocol": {"type": "string", "minLength": 1},
        "resource_arg_positions": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "track_method_receiver": {"type": "boolean"},
        "receiver_types": {"type": "array", "items": {"type": "string"}},
        "module_prefixes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "nullnessModel": {
      "type": "object",
      "required": ["call", "nullness_nullable_return"],
      "properties": {
        "call": {"type": "string", "minLength": 1},
        "aliases": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "nullness_nullable_return": {"const": true}
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": ["id", "title", "sources", "sinks", "severity"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "sinks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
        "cwe": {"type": "string", "pattern": "^CWE-[0-9]+$"},
        "suggestion": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
