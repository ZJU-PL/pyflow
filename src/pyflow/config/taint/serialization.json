{
  "schema_version": 2,
  "framework": "serialization",
  "version": "1.0",
  "description": "Serialization taint models (extracted from root rule pack)",
  "detection": {
    "imports": [
      "dill",
      "import dill",
      "cloudpickle",
      "import cloudpickle"
    ]
  },
  "models": [
    {
      "call": "dill._dill.Unpickler.__init__",
      "severity": "medium",
      "sinks": [
        {
          "kind": "execdeserializationsink",
          "port": {
            "parameter": 0
          }
        }
      ]
    },
    {
      "call": "dill._dill.load",
      "severity": "medium",
      "sinks": [
        {
          "kind": "execdeserializationsink",
          "port": {
            "parameter": 0
          }
        }
      ]
    },
    {
      "call": "dill._dill.load_session",
      "severity": "medium",
      "sinks": [
        {
          "kind": "execdeserializationsink",
          "port": {
            "parameter": 0
          }
        }
      ]
    },
    {
      "call": "dill._dill.loads",
      "severity": "medium",
      "sinks": [
        {
          "kind": "execdeserializationsink",
          "port": {
            "parameter": 0
          }
        }
      ]
    },
    {
      "call": "cloudpickle.load",
      "cwe": "CWE-502",
      "severity": "high",
      "suggestion": "Do not deserialize cloudpickle data from untrusted or attacker-controlled files.",
      "sinks": [
        {
          "kind": "execdeserializationsink",
          "port": {
            "parameter": 0
          }
        }
      ]
    },
    {
      "call": "cloudpickle.loads",
      "cwe": "CWE-502",
      "severity": "high",
      "suggestion": "Do not deserialize cloudpickle data from untrusted or attacker-controlled bytes.",
      "sinks": [
        {
          "kind": "execdeserializationsink",
          "port": {
            "parameter": 0
          }
        }
      ]
    }
  ],
  "rules": [
    {
      "id": "PYFLOW-SERIALIZATION-EXECDESERIALIZATIONSINK",
      "title": "Untrusted data reaches execdeserializationsink sink",
      "sources": [
        "user_input",
        "network",
        "file",
        "env",
        "database",
        "secrets",
        "cache",
        "userdata",
        "untrusted",
        "exception"
      ],
      "sinks": [
        "execdeserializationsink"
      ],
      "severity": "high"
    }
  ],
  "type": "taint"
}
