          "kind": "sql",
          "port": {
            "parameter": 1
          }
        }
      ]
    },
    {
      "call": "sqlalchemy.engine.interfaces.Connectable.execute",
      "cwe": "CWE-89",
      "severity": "high",
      "sinks": [
        {
          "kind": "sql",
