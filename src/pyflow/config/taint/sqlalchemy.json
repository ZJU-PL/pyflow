{
  "schema_version": 2,
  "framework": "sqlalchemy",
  "version": "1.0",
  "description": "Sqlalchemy taint models (extracted from root rule pack)",
  "detection": {
    "imports": [
      "sqlalchemy",
      "from sqlalchemy",
      "import sqlalchemy",
      "create_engine(",
      "declarative_base",
      "sessionmaker("
    ],
    "patterns": [
      "Column(",
      "relationship(",
      "Session(",
      "scoped_session"
    ]
  },
  "models": [
    {
      "call": "sqlalchemy.engine.Engine.execute",
      "sinks": [
        {
          "kind": "sql",
          "port": {
            "parameter": 0
          }
        }
      ]
    },
    {
      "call": "sqlalchemy.orm.Session.execute",
      "sinks": [
        {
          "kind": "sql",
          "port": {
            "parameter": 0
          }
        }
      ]
    },
    {
      "call": "sqlalchemy.orm.Session.query",
      "sinks": [
        {
          "kind": "dangerous",
          "port": {
            "parameter": 0
          }
        }
      ]
    },
    {
      "call": "sqlalchemy.engine.base.Connection.execute",
      "cwe": "CWE-89",
      "severity": "high",
      "sinks": [
        {
          "kind": "sql",
          "port": {
            "parameter": 1
          }
        }
      ]
    },
    {
      "call": "sqlalchemy.engine.base.Connection.run_callable",
