  "rules": [
    {
      "id": "PYFLOW-SQLALCHEMY-DANGEROUS",
      "title": "Untrusted data reaches dangerous sink",
      "sources": [
        "user_input",
        "network",
        "file",
        "env",
        "database",
        "secrets",
        "cache",
        "userdata",
        "untrusted",
        "exception"
      ],
      "sinks": [
        "dangerous"
      ],
      "severity": "high"
    },
    {
      "id": "PYFLOW-SQLALCHEMY-SQL",
      "title": "Untrusted data reaches sql sink",
      "sources": [
        "user_input",
        "network",
        "file",
        "env",
        "database",
        "secrets",
        "cache",
        "userdata",
        "untrusted",
        "exception"
