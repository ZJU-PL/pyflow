      "severity": "high",
      "sinks": [
        {
          "kind": "sql",
          "port": {
            "parameter": 1
          }
        }
      ]
    },
    {
      "call": "sqlalchemy.engine.base.Connection.scalar",
      "cwe": "CWE-89",
      "severity": "high",
      "sinks": [
        {
          "kind": "sql",
          "port": {
            "parameter": 1
          }
        }
      ]
    },
    {
      "call": "sqlalchemy.engine.base.Engine.execute",
      "cwe": "CWE-89",
      "severity": "high",
      "sinks": [
        {
          "kind": "sql",
          "port": {
            "parameter": 1
          }
        },
        {
          "kind": "sql",
          "port": {
            "parameter": 3
          }
