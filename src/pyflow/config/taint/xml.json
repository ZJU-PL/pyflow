{
  "schema_version": 2,
  "framework": "xml",
  "version": "1.0",
  "description": "Xml taint models (extracted from root rule pack)",
  "detection": {
    "imports": [
      "lxml",
      "from lxml"
    ]
  },
  "models": [
    {
      "call": "lxml.etree.fromstring",
      "cwe": "CWE-611",
      "severity": "high",
      "sinks": [
        {
          "kind": "xxe",
          "port": {
            "parameter": 0
          }
        }
      ]
    },
    {
      "call": "lxml.etree.fromstringlist",
      "cwe": "CWE-611",
      "severity": "high",
      "sinks": [
        {
          "kind": "xxe",
          "port": {
            "parameter": 0
          }
        }
      ]
    },
    {
      "call": "lxml.etree.parse",
      "cwe": "CWE-611",
      "severity": "high",
      "sinks": [
        {
          "kind": "xxe",
          "port": {
            "parameter": 0
          }
        }
      ]
    }
  ],
  "rules": [
    {
      "id": "PYFLOW-XML-XXE",
      "title": "Untrusted data reaches xxe sink",
      "sources": [
        "user_input",
        "network",
        "file",
        "env",
        "database",
        "secrets",
        "cache",
        "userdata",
        "untrusted",
        "exception"
      ],
      "sinks": [
        "xxe"
      ],
      "severity": "high"
    }
  ],
  "type": "taint"
}
