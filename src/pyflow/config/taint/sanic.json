{
  "schema_version": 2,
  "framework": "sanic",
  "version": "1.0",
  "description": "Sanic request-source and HTML-response taint models",
  "entrypoints": {"taint_parameters": true},
  "detection": {
    "imports": ["sanic", "import sanic", "from sanic"],
    "patterns": ["Sanic(", "sanic.response.html", "html("]
  },
  "models": [
    {
      "call": "sanic.request.Request.args.get",
      "sources": [{"kind": "user_input", "port": "return"}]
    },
    {
      "call": "sanic.request.Request.form.get",
      "sources": [{"kind": "user_input", "port": "return"}]
    },
    {
      "call": "html",
      "cwe": "CWE-79",
      "severity": "high",
      "sinks": [{"kind": "xss", "port": {"parameter": 0}}]
    }
  ],
  "rules": [
    {
      "id": "PYFLOW-SANIC-XSS",
      "title": "Untrusted data reaches an HTML response",
      "sources": ["user_input", "network", "file", "env", "database", "secrets", "cache", "userdata", "untrusted", "exception"],
      "sinks": ["xss"],
      "severity": "high"
    }
  ],
  "type": "taint"
}
